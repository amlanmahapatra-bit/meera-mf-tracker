# Copy this file to .env.local and fill in real values. .env.local is git-ignored.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=      # server-side only, never exposed to the browser
GEMINI_API_KEY=
GNEWS_API_KEY=
CRON_SECRET=                    # protects /api/cron/* routes
ADMIN_PASSCODE=                 # needed to add/remove funds from the form
