# Copy this file to .env.local and fill in real values. .env.local is git-ignored.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=      # server-side only, never exposed to the browser
OPENROUTER_API_KEY=            # Gemini Flash (google/ models only) is reached through OpenRouter
GNEWS_API_KEY=
CRON_SECRET=                    # protects /api/cron/* routes
ADMIN_PASSCODE=                 # needed to add/remove funds from the form

# --- Saturday email (optional; the email step is skipped until these are set) ---
RESEND_API_KEY=                 # from resend.com (free plan is plenty: 1 email a week)
REPORT_EMAIL_TO=                # Meera's email address (several allowed, separated by commas)
RESEND_FROM=                    # e.g. Meera's Money Check <onboarding@resend.dev>  (own domain needed to email anyone but yourself)
SITE_URL=                       # your public website address, used for the "Open the full check-up" button
